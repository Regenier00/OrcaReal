# Copie este arquivo para .env e preencha com o projeto Supabase.
# Dashboard → Settings → API Keys (ou o modal Connect do Vite).
# Reinicie o `npm run dev` depois de salvar.

VITE_SUPABASE_URL=https://your-project.supabase.co

# Dashboard novo: chave publishable (sb_publishable_...).
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Projetos antigos ainda usam a anon JWT. Qualquer uma das duas funciona.
# VITE_SUPABASE_ANON_KEY=your-anon-key
